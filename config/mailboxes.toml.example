# Every mailbox the analyzer knows about. Copy this file to config/mailboxes.toml
# (which is gitignored) and edit it, or let Outlook fill it in for you:
#
#   .venv/Scripts/python.exe scripts/analyze_mailbox.py --init-config
#
# Then run one mailbox by name, or all of the enabled ones:
#
#   ... scripts/analyze_mailbox.py --mailbox dostawcy
#   ... scripts/analyze_mailbox.py --all

[llm]
base_url = "http://localhost:1234/v1"
model = "qwen/qwen3-30b-a3b-2507"

# What the suppliers were actually asked. Fill this in -- it is the difference
# between the model judging "does this message agree?" and "does this message
# agree to THIS?". Without it, "Potwierdzam odbior" is scored as consent,
# because on its own terms it is a confirmation of something.
[campaign]
subject = "Zgoda na zmiane warunkow platnosci od 2026-09-01"
description = """
Prosimy o potwierdzenie zgody na wydluzenie terminu platnosci do 60 dni
dla zamowien skladanych po 1 wrzesnia 2026.
"""

# Scanned consents: a printed request, signed, scanned, sent back as a PDF or a
# photograph. Off by default because it needs a SECOND model loaded in LM Studio
# alongside the classifier -- switch it on only once that model is loaded, or
# every scan costs a failed call.
#
# The vision model only ever transcribes; the usual classifier still decides.
# Every message read this way is queued for a person, because the grounding
# check cannot catch a misread word: the quote and the source are then both the
# transcription.
[vision]
enabled = false
model = "qwen2.5-vl-32b-instruct"
# base_url = "http://localhost:1234/v1"   # omit to share the classifier's endpoint
max_pages = 4      # pages of one scanned document sent in a single call

# Attachments are read in memory and classified alongside the body. When the
# attachment disagrees with the body, the message goes to the review queue
# rather than one of them being picked silently.
[attachments]
enabled = true
max_chars = 12000   # cap on the combined attachment text handed to the model

# Inherited by every [[mailbox]] below unless it says otherwise.
[defaults]
limit = 0          # 0 = no limit
enabled = true

[[mailbox]]
name = "dostawcy"                # how you refer to it on the command line
store = "zgody@firma.pl"         # mailbox name or address; matched loosely
folder = "Skrzynka odbiorcza"    # omit entirely to use the store's inbox
since = 2026-07-25               # ignore anything received before this day

[[mailbox]]
name = "moja"
store = "you@firma.pl"
# no folder: whatever Outlook calls this store's inbox
enabled = false
